{
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/art/*", "headers": { "Cache-Control": "public, max-age=604800" } },
    { "route": "/", "rewrite": "/index.html" },
    { "route": "/demo", "rewrite": "/index.html" },
    { "route": "/privacy", "rewrite": "/index.html" },
    { "route": "/terms", "rewrite": "/index.html" },
    { "route": "/license", "rewrite": "/index.html" },
    { "route": "/health", "rewrite": "/api/health" },
    { "route": "/favicon.svg", "headers": { "Cache-Control": "public, max-age=604800" } },
    { "route": "/apple-touch-icon.png", "headers": { "Cache-Control": "public, max-age=604800" } },
    { "route": "/social-card.webp", "headers": { "Cache-Control": "public, max-age=604800" } },
    { "route": "/404.html", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/404.css", "headers": { "Cache-Control": "public, max-age=604800" } },
    { "route": "/manifest.webmanifest", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/robots.txt", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/sitemap.xml", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/*", "statusCode": 404 }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://api.sociobot.in; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://api.sociobot.in",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "X-Frame-Options": "DENY"
  }
}
